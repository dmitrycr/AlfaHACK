# Copy with scripts/setup.sh; generated values are local development secrets.
APP_ENV=development
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
SEED_DEMO=true
SOURCE_MODE=fixture
COMPANY_REGISTRY_MODE=mock
EMAIL_DELIVERY_MODE=mock
DEMO_PASSWORD=DemoOnly-2026!
POSTGRES_PASSWORD=replace_with_generated_hex
AUTH_DB_PASSWORD=replace_with_generated_hex
COMPANY_DB_PASSWORD=replace_with_generated_hex
NEWS_DB_PASSWORD=replace_with_generated_hex
EVENTS_DB_PASSWORD=replace_with_generated_hex
ANALYTICS_DB_PASSWORD=replace_with_generated_hex
INTERNAL_KEY=replace_with_at_least_32_random_bytes
GATEWAY_PORT=8080
POSTGRES_PORT=15432
KAFKA_PORT=19092

# Backend LLM pipeline: all outputs and costs are simulated in mock mode.
AGENT_DB_PASSWORD=replace_with_generated_hex
INSIGHTS_DB_PASSWORD=replace_with_generated_hex
LLM_MODE=mock
LLM_MOCK_SCENARIO=success
LLM_DAILY_LIMIT_MINOR=50000
LLM_MAX_PARALLEL=4
LLM_TIMEOUT_SECONDS=3
MATCH_MODE=mock

# HTTP provider stays disabled until the contract and tariff unit are confirmed.
LLM_API_KEY=
LLM_BASE_URL=https://changellenge.up.railway.app/v1
LLM_FALLBACK_BASE_URL=https://api.alfahack-gateway26.ru/v1
LLM_CONFIG_REVISION=1
LLM_PAID_CALLS_ENABLED=false
LLM_PRICE_UNIT_TOKENS=0
LLM_TARIFFS_CONFIRMED=false
LLM_PRICES_JSON=
LLM_KEY_INFO_URL=
LLM_KEY_INFO_REMAINING_PATH=
LLM_BUDGET_CONTRACT_CONFIRMED=false
LLM_USAGE_CONTRACT_CONFIRMED=false
LLM_TOKEN_LIMIT_PARAMETER=
LLM_TOKEN_LIMIT_CONFIRMED=false
LLM_ALLOW_KIMI=false
LLM_MODEL_TAG=z-ai/glm-5.3-flash
LLM_MODEL_PROFILE=deepseek/deepseek-v4.1-flash
LLM_MODEL_INSIGHT=qwen/qwen3.6-35b-a3b
LLM_MODEL_CHECK=google/gemma-4-26b-a4b-it
LLM_MODEL_CHAT=z-ai/glm-5.3-flash
